    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug md2docx modelo_teste",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "modelo_teste.md",
                "saida/modelo_teste.docx",
                "--template-docx",
